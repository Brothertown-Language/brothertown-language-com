{
	// Assets-only deployment manifest — Cloudflare Workers Static Assets.
	// No Worker script, no bindings: the built site in ./public IS the deploy.
	// Deployed via `npx wrangler deploy` per the wiki-hosted runbook (issue #3).
	// SPDX-FileCopyrightText: 2026 Brothertown Language
	// SPDX-License-Identifier: MIT
	"name": "brothertown-language-com",
	"compatibility_date": "2026-10-26",
	// PR-preview builds run `npx wrangler preview`, which requires this block
	// (wrangler 4.153.0; empty block suffices — top-level settings stay put).
	"previews": {},
	"assets": {
		"directory": "./public",
		"not_found_handling": "404-page"
	}
}